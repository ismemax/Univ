{
    "rules": {
        "active_session": {
            ".read": true,
            ".write": "!data.exists() || data.child('status').val() === 'active' || data.child('status').val() === 'waiting'",
            "participantsCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "allResponses": {
                "$questionIndex": {
                    ".write": "data.parent().parent().exists()",
                    ".validate": "newData.hasChildren()"
                }
            }
        },
        "users": {
            "$uid": {
                ".read": "$uid === auth.uid",
                ".write": "$uid === auth.uid"
            }
        }
    }
}
/* 
IMPORTANT: 
Your previous security rules were blocking the creation of the session.
