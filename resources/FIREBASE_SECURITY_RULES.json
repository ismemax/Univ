
{
    "rules": {
        "active_session": {
            ".read": true,
            ".write": "!data.exists() || !newData.exists() || data.child('status').val() === 'active' || data.child('status').val() === 'paused' || data.child('status').val() === 'waiting' || data.child('status').val() === 'ended'",
            "identities": {
                ".write": "data.parent().exists() && data.parent().child('status').val() !== 'ended'",
                "$nameKey": {
                    ".validate": "newData.isString() && newData.val().length > 0"
                }
            },
            "participantsCount": {
                ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
            },
            "allResponses": {
                "$qIdx": {
                    ".write": "root.child('active_session/status').val() === 'active'",
                    "$optionIdx": {
                        ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
                    },
                    "text": {
                        ".validate": "newData.hasChildren()"
                    },
                    "rankings": {
                        ".validate": "newData.hasChildren()"
                    },
                    "namedResponses": {
                        ".validate": "newData.hasChildren()"
                    }
                }
            }
        },
        "attendance": {
            "$sessionId": {
                ".read": true,
                "$nameKey": {
                    ".write": "root.child('active_session/id').val() === $sessionId && root.child('active_session/status').val() !== 'ended'",
                    ".validate": "newData.isString() && newData.val().length > 0"
                }
            }
        }
    }
}