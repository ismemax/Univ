{
    "rules": {
        "active_session": {
            ".read": true,
            // Rule: Allow write if creating a new session (!data.exists), 
            // or if clearing an old one (newData == null), 
            // or if the current session is in a modifiable state (active/waiting/ended).
            ".write": "!data.exists() || !newData.exists() || data.child('status').val() === 'active' || data.child('status').val() === 'waiting' || data.child('status').val() === 'ended'",
            "participantsCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "allResponses": {
                "$questionIndex": {
                    ".write": "data.parent().parent().exists()",
                    ".validate": "newData.hasChildren()"
                }
            }
        },
        "users": {
            "$uid": {
                ".read": "$uid === auth.uid",
                ".write": "$uid === auth.uid"
            }
        }
    }
}